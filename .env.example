# UNG-OLYMPUS — environment variables
# Copy to .env for local dev, or set these directly in Railway's Variables tab.

# --- Required before a real (non-throwaway) deploy ---

# Signs session tokens. If you don't set this, OLYMPUS will generate one and
# warn loudly — but every fresh deploy will then invalidate every session.
# Generate a real one with: python3 -c "import secrets; print(secrets.token_hex(32))"
OLYMPUS_JWT_SECRET=

# --- First-boot admin account ---
# Created automatically ONLY if the users table is empty. If you don't set
# OLYMPUS_ADMIN_PASSWORD, one is generated and printed to the startup logs —
# check there once, then rotate it via the dashboard.
OLYMPUS_ADMIN_EMAIL=admin@ung-olympus.local
OLYMPUS_ADMIN_PASSWORD=

# --- Logistics domain adapters (Phase 1) ---
# Leave unset to run on demo data. Each is a SERVICE key issued by that
# subsystem for OLYMPUS specifically — never a personal login.
MERCURY_API_URL=
MERCURY_API_KEY=
VECTOR_API_URL=
VECTOR_API_KEY=

# --- Optional ---

# Where the SQLite file lives. Defaults to ./olympus.db.
OLYMPUS_DB_PATH=

# Only used as a local-dev fallback when OLYMPUS_JWT_SECRET isn't set —
# path to persist a generated secret so restarts don't invalidate sessions.
# Defaults to ./.jwt_secret. Irrelevant once OLYMPUS_JWT_SECRET is set.
OLYMPUS_JWT_SECRET_FILE=
